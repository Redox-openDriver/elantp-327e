dev-usage = usage: elantp-dev info | record <file> [seconds] | show <file> | gestures [--summary] <file> | live
dev-error = error: { $detail }
dev-not-found = touchpad { $device } not found among hidraw devices
dev-found = touchpad: { $node } ({ $name })
dev-verified = verified variant: { $device }, descriptor of { $length } bytes
dev-unverified = this variant is not verified: { $reason }; the driver will not work with it
dev-unverified-vendor = another vendor ({ $found })
dev-unverified-product = another model ({ $found })
dev-unverified-descriptor = another descriptor ({ $length } bytes, digest { $found })
dev-bad-descriptor = the report descriptor did not parse: { $detail }
dev-not-touchpad = no touchpad in the descriptor: { $detail }
dev-layout = report { $report }: { $slots } contacts per report, button: { $button }; pad { $width } × { $height } mm, { $resolution } units per mm
dev-yes = yes
dev-no = no
dev-more-as-root = the sensor reports the pad type and contact count only under sudo
dev-capabilities = up to { $contacts } contacts at once; { $kind }
dev-pad-clickpad = the whole pad clicks as a button
dev-pad-pressure = the pad senses pressure
dev-pad-buttons = separate buttons, the pad does not click
dev-pad-unknown = pad type not given
dev-needs-root = no access to { $node }: run it with sudo
dev-open-failed = could not open { $node }: { $detail }
dev-exists = { $file } already exists, not overwriting it
dev-write-failed = could not write { $file }: { $detail }
dev-read-failed = could not read { $file }: { $detail }
dev-bad-recording = { $file } is not a touch recording: { $detail }
dev-chown-failed = could not hand the recording over to the user: { $detail }
dev-bad-seconds = “{ $value }” is not a number of seconds
dev-recording = recording touches to { $file }; Ctrl+C to stop
dev-recorded = recorded { $count } reports in { $seconds } s
dev-live = touchpad contacts; Ctrl+C to quit
dev-shown = frames: { $frames }, reports skipped: { $skipped }
dev-frame = { $time } ms, { $count } contacts, button { $button }: { $contacts }
dev-button-down = down
dev-button-up = up
dev-contact = #{ $id } ({ $x }; { $y } mm) { $state }
dev-contact-touching = touching
dev-contact-lifted = lifted
dev-contact-palm = palm?
dev-gesture-at = { $time } ms: { $event }
dev-gesture-motion = pointer moved by ({ $dx }; { $dy })
dev-gesture-press = { $button } pressed
dev-gesture-release = { $button } released
dev-gesture-left = left button
dev-gesture-right = right button
dev-gesture-middle = middle button
dev-gesture-swipe = { $fingers }-finger swipe, { $phase } ({ $dx }; { $dy } mm)
dev-gesture-begin = start
dev-gesture-update = continued
dev-gesture-end = end
dev-gesture-summary = total: left presses { $left }, right { $right }, middle { $middle }; pointer travel { $travel }; scroll ({ $scroll-x }; { $scroll-y }); swipes { $swipes }
