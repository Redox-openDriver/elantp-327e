dev-usage = usage: elantp-dev info | record <file> [seconds] | show <file> | gestures [--summary] <file> | live | drive [--natural] [--speed <factor>] | session [--dir <directory>] [exercises…]
dev-error = error: { $detail }
dev-not-found = touchpad { $device } not found among hidraw devices
dev-found = touchpad: { $node } ({ $name })
dev-verified = verified variant: { $device }, descriptor of { $length } bytes
dev-unverified = this variant is not verified: { $reason }; the driver will not work with it
dev-unverified-vendor = another vendor ({ $found })
dev-unverified-product = another model ({ $found })
dev-unverified-descriptor = another descriptor ({ $length } bytes, digest { $found })
dev-bad-descriptor = the report descriptor did not parse: { $detail }
dev-not-touchpad = no touchpad in the descriptor: { $detail }
dev-layout = report { $report }: { $slots } contacts per report, button: { $button }; pad { $width } × { $height } mm, { $resolution } units per mm
dev-yes = yes
dev-no = no
dev-more-as-root = the sensor reports the pad type and contact count only under sudo
dev-capabilities = up to { $contacts } contacts at once; { $kind }
dev-pad-clickpad = the whole pad clicks as a button
dev-pad-pressure = the pad senses pressure
dev-pad-buttons = separate buttons, the pad does not click
dev-pad-unknown = pad type not given
dev-needs-root = no access to { $node }: run it with sudo
dev-open-failed = could not open { $node }: { $detail }
dev-exists = { $file } already exists, not overwriting it
dev-write-failed = could not write { $file }: { $detail }
dev-read-failed = could not read { $file }: { $detail }
dev-bad-recording = { $file } is not a touch recording: { $detail }
dev-chown-failed = could not hand the recording over to the user: { $detail }
dev-bad-seconds = “{ $value }” is not a number of seconds
dev-recording = recording touches to { $file }; Ctrl+C to stop
dev-recorded = recorded { $count } reports in { $seconds } s
dev-live = touchpad contacts; Ctrl+C to quit
dev-shown = frames: { $frames }, reports skipped: { $skipped }
dev-frame = { $time } ms, { $count } contacts, button { $button }: { $contacts }
dev-button-down = down
dev-button-up = up
dev-contact = #{ $id } ({ $x }; { $y } mm) { $state }
dev-contact-touching = touching
dev-contact-lifted = lifted
dev-contact-palm = palm?
dev-gesture-at = { $time } ms: { $event }
dev-gesture-motion = pointer moved by ({ $dx }; { $dy })
dev-gesture-press = { $button } pressed
dev-gesture-release = { $button } released
dev-gesture-left = left button
dev-gesture-right = right button
dev-gesture-middle = middle button
dev-gesture-swipe = { $fingers }-finger swipe, { $phase } ({ $dx }; { $dy } mm)
dev-gesture-begin = start
dev-gesture-update = continued
dev-gesture-end = end
dev-gesture-summary = total: left presses { $left }, right { $right }, middle { $middle }; pointer travel { $travel }; scroll ({ $scroll-x }; { $scroll-y }); swipes { $swipes }
session-intro = Let's record how you use the touchpad: { $count } exercises, 20 to 30 seconds each.
session-intro-grab = While recording, the touchpad neither moves the pointer nor clicks anything, so gesture freely. The keyboard works as usual.
session-intro-keys = Before each exercise read the task and press Enter. Ctrl+C during a recording ends the session; what was recorded is kept.
session-start = Enter to start, q to quit:
session-step = Exercise { $number } of { $count }: { $title } ({ $seconds } s)
session-ask = Enter to start, n to skip, q to finish:
session-again = Enter to repeat, n for the next one, q to finish:
session-countdown = { $seconds }…
session-go = Go!
session-recording = { $seconds } s left · fingers on the touchpad: { $fingers }
session-result = recorded { $frames } frames; up to { $most } fingers at once; { $taps } taps, { $multi } multi-finger taps, { $presses } clicks
session-interrupted = recording stopped, what was recorded is kept
session-grab-failed = could not detach the touchpad from the pointer ({ $detail }); the pointer will move, keep it over an empty part of the screen
session-unknown = there is no exercise “{ $name }”; there are: { $names }
session-summary-line = { $name }: { $state }
session-state-good = done
session-state-weak = little data, can be repeated later
session-saved = recordings saved in { $dir }
session-next = Done. Tell me in the chat that the recordings are there and I will go through them.
session-move = Moving one finger
session-move-how = Move one finger over the whole pad: slowly at first, then fast, in different directions, in circles and from edge to edge.
session-move-hint = The finger hardly moved; more movement over the pad is needed.
session-tap = One-finger taps
session-tap-how = Touch briefly with one finger and lift at once, without pressing to a click: single taps and double taps (two quick ones), in different places.
session-tap-hint = Hardly any taps; a tap must be short, under a third of a second, without moving the finger.
session-click = Pressing to a click
session-click-how = Press the pad with one finger until it clicks and let go: in the middle, near the bottom edge, in the corners.
session-click-hint = Hardly any clicks; press harder, until you hear the click.
session-drag = Dragging
session-drag-how = Press until it clicks and, without letting go, move the finger, then release, as if dragging a window. Repeat a few times. You may hold the click with one finger and move another.
session-drag-hint = No dragging seen; press to a click and move the finger without releasing.
session-scroll = Two-finger scrolling
session-scroll-how = Put two fingers side by side and move them together: up and down, then left and right, slowly and fast.
session-scroll-hint = Hardly any time with two fingers; keep both fingers on the pad.
session-tap2 = Two- and three-finger taps
session-tap2-how = Touch briefly with two fingers at once and lift, the way a right click is done. A few times, then the same with three fingers.
session-tap2-hint = Hardly any multi-finger taps; touch with the fingers together and briefly.
session-swipe = Three- and four-finger swipes
session-swipe-how = Swipe left, right, up and down with three fingers. Then the same with four.
session-swipe-hint = Hardly any time with three fingers; put three or four fingers on the pad.
session-thumb = Thumb resting, another finger moving
session-thumb-how = Rest your thumb on the bottom edge of the pad and keep it still while the index finger moves over the pad, the way a finger often waits before a click.
session-thumb-hint = Hardly any time with two fingers; the thumb has to stay down the whole time.
session-palm = Palm while typing
session-palm-how = Type any text as usual, with your hands placed so the edge of a palm sometimes brushes the touchpad. What you type goes nowhere.
session-palm-hint = The palm did not touch the pad; that is a useful recording too.
dev-drive-start = the touchpad is driven by our driver (gestus); Ctrl+C gives it back to the system
dev-drive-stop = the system touchpad driver works again
dev-uinput-failed = could not create a virtual mouse: { $detail }
dev-grab-failed = could not take the touchpad from the system driver: { $detail }
dev-bad-speed = “{ $value }” is not a speed factor from 0.1 to 5
dev-bad-option = unknown option: { $value }
